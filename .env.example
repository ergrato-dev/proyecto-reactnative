# NASA APIs (registrar en https://api.nasa.gov/ — aprobación inmediata, gratuita)
# Usar DEMO_KEY solo para pruebas locales rápidas (límite: 30 req/hora por IP)
EXPO_PUBLIC_NASA_API_KEY=DEMO_KEY

# Supabase (crear proyecto en https://supabase.com — free tier)
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
